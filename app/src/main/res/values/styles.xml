<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme for the single-activity Compose app.
         The Compose UI (Material 3) is styled by NutritionTrackerTheme;
         this theme only covers the pre-compose window & system bars. -->
    <style name="Theme.NutritionTracker" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/teal_700</item>
        <item name="android:navigationBarColor">@color/slate_900</item>
        <item name="android:windowBackground">@color/slate_50</item>
    </style>
</resources>
